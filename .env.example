# Copy to .env and adjust. For docker-compose, the DB values below are already wired.
DATABASE_URL=postgres://store:storepass@localhost:5432/storeaccounts
SESSION_SECRET=change-this-to-a-long-random-string
PORT=3000
# Set to "true" when serving behind HTTPS (secure cookies)
COOKIE_SECURE=false
# Comma-separated origins allowed for CORS (leave empty to disable CORS; same-origin needs nothing)
CORS_ORIGINS=
